# Local AI provider. Use one provider at a time.
# openai | anthropic | claude
EXPO_PUBLIC_LLM_PROVIDER=openai

# OpenAI
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# Claude / Anthropic
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-3-5-haiku-latest

# External ChatGPT / Claude push sync.
# In production this should point to the deployed AIOS backend.
EXPO_PUBLIC_LIFEOS_API_BASE_URL=
EXPO_PUBLIC_LIFEOS_SYNC_TOKEN=

# Server-only token for deployed /api/lifeos/intake.
# Do not expose this in mobile client builds unless this is a private prototype.
LIFEOS_INTAKE_TOKEN=
